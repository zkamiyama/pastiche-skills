+class TimelineAuditTests(unittest.TestCase):
+    def test_dependency_cannot_run_before_its_prerequisite(self):
+        p = false_belief_plan()
+        p['epistemic']['events'][0]['order'] = 2
+        # The dependent event's belief premise is otherwise satisfiable.
+        with self.assertRaisesRegex(ValueError, 'chronolog|prerequisite'):
+            replay(p)
+
+    def test_flashback_can_depend_on_an_earlier_story_event_shown_later(self):
+        p = false_belief_plan()
+        p['scenes'].reverse()
+        context = {'mode': 'original', 'world_mode': 'original',
+                   'characters': {'entities': []}, 'plot_patterns': []}
+        clean = validate_plan(p, context)
+        self.assertEqual(clean['scenes'][0]['id'], 'return')
+
+    def test_identifier_whitespace_is_rejected_not_silently_split(self):
+        p = false_belief_plan()
+        p['epistemic']['events'][0]['id'] = ' E1 '
+        with self.assertRaises(ValueError):
+            replay(p)
+
+    def test_duplicate_scene_or_character_is_rejected_by_standalone_replay(self):
+        for section in ('scenes', 'characters'):
+            p = false_belief_plan()
+            p[section].append(copy.deepcopy(p[section][0]))
+            with self.subTest(section=section), self.assertRaises(ValueError):
+                replay(p)
+
+    def test_misspelled_state_operation_is_not_silently_ignored(self):
+        p = false_belief_plan()
+        e = p['epistemic']['events'][0]
+        e['observatons'] = e.pop('observations')
+        with self.assertRaisesRegex(ValueError, 'field|key'):
+            replay(p)
+
+    def test_malformed_operation_is_validation_error_not_incidental_crash(self):
+        for field in ('updates', 'observations', 'messages', 'inferences', 'forget', 'requires'):
+            for value in (None, [], 'not a record', True):
+                p = false_belief_plan()
+                p['epistemic']['events'][0][field] = [value]
+                with self.subTest(field=field, value=value), self.assertRaises(ValueError):
+                    replay(p)
+
+    def test_replay_returns_detached_normalized_records(self):
+        p = false_belief_plan()
+        expected = copy.deepcopy(p)
+        r = replay(p)
+        r['timeline']['facts'][0]['values'].append('injected')
+        self.assertEqual(p, expected)
+
+    def test_private_context_does_not_export_scene_exit_knowledge_at_entry(self):
+        p = false_belief_plan()
+        event = p['epistemic']['events'][1]
+        event['access']['A'] = ['sight']
+        event['observations'] = [{'agent':'A','fact':'F','channel':'sight'}]
+        view = scene_view(p, 'return', 'A')
+        # The default is usable BEFORE writing a scene. Its end-state is not
+        # already known to the actor at scene entry.
+        self.assertNotIn('箱', json.dumps(view, ensure_ascii=False))
+
