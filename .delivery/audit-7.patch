+"""Adversarial regressions for the v3 correctness audit; synthetic inputs only."""
+from __future__ import annotations
+import copy
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import redirect_stderr
+from unittest.mock import patch
+
+SCRIPTS = Path(__file__).resolve().parents[1] / 'skills/pastiche-profile/scripts'
+sys.path.insert(0, str(SCRIPTS))
+import llm_runtime
+import task_transport as transport
+from story_workbench.epistemic import simulate, scene_view
+from story_workbench.engine import Engine, Task
+from story_workbench.store import Store, Conflict, atomic_json, uid
+from story_workbench.writing import prepare, validate_plan, make_plan, audit_draft
+from test_epistemic import false_belief_plan
+from test_world import WorldFixture
+
+
+def replay(p):
+    return simulate(p['epistemic'], p['scenes'], p['characters'])
+
