+class BoundaryAuditTests(unittest.TestCase):
+    def test_task_request_is_verified_before_delegation_not_only_submission(self):
+        with tempfile.TemporaryDirectory() as d:
+            root=Path(d);m=transport.SubagentModel(root)
+            with self.assertRaises(transport.TasksPending):m.ask('original inert data')
+            task=transport.list_tasks(root)[0]['task_id']
+            p=root/'requests'/f'{task}.json';value=json.loads(p.read_text());value['prompt']='tampered'
+            p.write_text(json.dumps(value),encoding='utf-8')
+            with self.assertRaisesRegex(ValueError,'modified'):transport.list_tasks(root)
+
+    def test_invalid_unicode_and_nonfinite_exponent_are_rejected(self):
+        from json_boundary import loads
+        for raw in ('{"a":1e9999}', '{"a":"\\ud800"}', '{"a":NaN}'):
+            with self.subTest(raw=repr(raw)),self.assertRaises(ValueError):loads(raw)
+
+    def test_excessively_nested_json_is_a_controlled_rejection(self):
+        from json_boundary import loads
+        with self.assertRaises(ValueError):loads('['*2000+'0'+']'*2000)
+
+    def test_nonfinite_progress_interval_is_rejected(self):
+        for value in (float('nan'),float('inf'),-1,True):
+            with self.assertRaises(ValueError):llm_runtime.ProgressReporter(Path('/unused'),value)
+
+    def test_stream_truncation_remains_nonretryable(self):
+        model=llm_runtime.HTTPModel('ollama','fixture','http://localhost:11434')
+        frame={'response':'{}','done':True,'done_reason':'length'}
+        with self.assertRaises(llm_runtime.ModelRequestError) as cm:
+            model._stream_text(io.BytesIO((json.dumps(frame)+'\n').encode()))
+        self.assertFalse(cm.exception.transient)
+
+    def test_explicit_event_view_is_entry_not_end_of_event(self):
+        p=false_belief_plan()
+        e=p['epistemic']['events'][1]
+        e['access']['A']=['sight'];e['observations']=[{'agent':'A','fact':'F','channel':'sight'}]
+        p['epistemic']['events'].append({'id':'E3','scene_id':'return','order':2,'participants':['A'],'access':{}})
+        before=scene_view(p,'return','A',event_id='E2')
+        later=scene_view(p,'return','A',event_id='E3')
+        self.assertEqual(before['events'][0]['beliefs_before']['F']['value'],'かご')
+        self.assertEqual(later['events'][0]['beliefs_before']['F']['value'],'箱')
+        with self.assertRaises(ValueError):scene_view(p,'return','A',event_id='E1')
+
+    def test_finite_snapshot_byte_limit_includes_reports(self):
+        # Explicitly lower the byte budget locally for a cheap boundary check.
+        import story_workbench.epistemic as epistemic
+        original=epistemic.dump
+        p=false_belief_plan()
+        def counted(value):
+            encoded=original(value)
+            if isinstance(value,dict) and 'before' in value and 'after' in value:
+                return 'x'*16_000_001
+            return encoded
+        with patch.object(epistemic,'dump',counted),self.assertRaisesRegex(ValueError,'byte budget'):
+            replay(p)
+
+    def test_invalid_draft_plan_invalidates_previous_completion_marker(self):
+        with tempfile.TemporaryDirectory() as d:
+            root=Path(d);context=prepare(root,'fixture')
+            atomic_json(root/'writing/operation_status.json',{'state':'completed','operation':'draft_audit'})
+            with self.assertRaises(ValueError):
