+class TransportAuditTests(unittest.TestCase):
+    def test_duplicate_json_keys_are_not_accepted_as_a_worker_result(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d)/'answer.json'
+            path.write_text('{"decision":true,"decision":false}', encoding='utf-8')
+            with self.assertRaises(ValueError):
+                transport._read(path)
+
+    def test_nonfinite_or_nonjson_callback_values_are_rejected(self):
+        for value in ({'x':float('nan')}, {'x':float('inf')}, {1:'bad key'}, {'x':(1,2)}):
+            with self.subTest(value=repr(value)), self.assertRaises(ValueError):
+                transport.CallableModel(lambda _:value,'fixture').ask('inert data')
+
+    def test_only_one_concurrent_submission_wins_without_replace(self):
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d); model = transport.SubagentModel(root)
+            with self.assertRaises(transport.TasksPending):
+                model.ask('one synthetic task')
+            task = transport.list_tasks(root)[0]['task_id']
+            target = root/'responses'/f'{task}.json'
+            barrier = threading.Barrier(2)
+            original = Path.exists
+            def both_observe_absence(p):
+                result = original(p)
+                if p == target and not result:
+                    barrier.wait(timeout=5)
+                return result
+            def submit(n):
+                try:
+                    transport.submit(root, task, {'answer':n})
+                    return 'ok'
+                except ValueError:
+                    return 'rejected'
+            # Deterministically expose the pre-check/replace race; corrected
+            # code uses an atomic publish and does not need this pre-check.
+            with patch.object(Path, 'exists', both_observe_absence), ThreadPoolExecutor(2) as pool:
+                outcomes = list(pool.map(submit, [1,2]))
+            self.assertEqual(sorted(outcomes), ['ok','rejected'])
+
+    def test_engine_rejects_duplicate_task_ids_before_any_model_call(self):
+        with tempfile.TemporaryDirectory() as d:
+            s=Store(Path(d)/'db.sqlite3'); calls=[]
+            try:
+                engine=Engine(s,transport.CallableModel(lambda p:calls.append(p) or {},'fixture'),Path(d),retries=0,interval=0)
+                with redirect_stderr(io.StringIO()), self.assertRaises(ValueError):
+                    engine.run('stage',[Task('same','first',lambda x:x),Task('same','second',lambda x:x)])
+                self.assertEqual(calls,[])
+            finally:s.close()
+
+    def test_stream_length_finish_is_not_a_success_even_with_valid_json(self):
+        model=llm_runtime.HTTPModel('openai-compatible','fixture','http://localhost/v1')
+        frame={'choices':[{'delta':{'content':'{"observations":[]}'},'finish_reason':'length'}]}
+        raw=('data: '+json.dumps(frame)+'\n\ndata: [DONE]\n').encode()
+        with self.assertRaises(llm_runtime.ModelRequestError):
+            model._stream_text(io.BytesIO(raw))
+
+    def test_stream_nonobject_event_is_controlled_validation_failure(self):
+        model=llm_runtime.HTTPModel('openai-compatible','fixture','http://localhost/v1')
+        with self.assertRaises(llm_runtime.ModelRequestError):
+            model._stream_text(io.BytesIO(b'data: []\n\ndata: [DONE]\n'))
