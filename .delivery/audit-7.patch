+class SnapshotAuditTests(WorldFixture):
+    def test_empty_claim_section_cannot_smuggle_entity_records(self):
+        context=prepare(self.out,'novel:one')
+        context['world']['entities']=[{'id':'fabricated','name':'not registered','entity_type':'place'}]
+        store=Store(self.out/'character_graph.sqlite3')
+        try:
+            with self.assertRaises(Conflict):store.validate_context_snapshot(context)
+        finally:store.close()
+
+    def test_stale_plot_patterns_are_rejected_at_use_not_just_export(self):
+        store,src,*_ = self.fixture()
+        try:
+            pattern={'id':'P1','status':'model_supported','support_count':2,'steps':['a','b']}
+            bundle={'schema':'pastiche.plot.patterns.v1','scope':src['scope'],'work_ids':['W1','W2'],
+                    'source_versions':{src['id']:src['sha256']},'patterns':[pattern]}
+            store.artifact(uid('CORPUS',bundle['work_ids']),'patterns',bundle)
+            atomic_json(self.out/'plot_patterns.json',bundle)
+        finally:store.close()
+        context=prepare(self.out,src['scope'])
+        self.assertEqual(len(context['plot_patterns']),1)
+        # Remove other sections to isolate the stale plot-profile path.
+        for key in ('characters','world','perspectives'):
+            context[key]['claims']=[]; context[key]['entities']=[]
+        Path(src['path']).write_text('changed input',encoding='utf-8')
+        store=Store(self.out/'character_graph.sqlite3')
+        try:
+            with self.assertRaises(Conflict):store.validate_context_snapshot(context)
+        finally:store.close()
+
+    def test_claim_withdrawal_during_model_call_prevents_new_plan_publication(self):
+        store,src,*rest = self.fixture(); claim_id=rest[-1]; store.close()
+        context=prepare(self.out,src['scope'])
+        def callback(prompt):
+            if prompt.startswith('TASK=WRITE_PLAN'):
+                return false_belief_plan()
+            store=Store(self.db)
+            try:store.review(claim_id,'revoke',1,'human','withdrawn during inference')
+            finally:store.close()
+            return {'issues':[]}
+        with redirect_stderr(io.StringIO()), self.assertRaises(Conflict):
+            make_plan(self.out,context,'synthetic brief',transport.CallableModel(callback,'fixture'),retries=0,interval=0)
+        self.assertFalse((self.out/'writing/story_blueprint.json').exists())
+
+    def test_draft_change_during_model_call_invalidates_audit(self):
+        context=prepare(self.out,'fixture')
+        draft=self.root/'draft.txt';draft.write_text('Synthetic draft text.',encoding='utf-8')
+        def callback(prompt):
+            draft.write_text('The draft was changed.',encoding='utf-8')
+            return {'issues':[]}
+        with redirect_stderr(io.StringIO()), self.assertRaises(Conflict):
+            audit_draft(self.out,draft,false_belief_plan(),context,transport.CallableModel(callback,'fixture'),retries=0,interval=0)
+        self.assertFalse((self.out/'writing/plot_audit.json').exists())
